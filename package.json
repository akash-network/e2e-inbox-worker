{
  "name": "e2e-inbox-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Email Worker that captures e2e OTP emails into D1 and serves them over a token-protected HTTP endpoint",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/akash-network/e2e-inbox-worker.git"
  },
  "engines": {
    "node": "^24.14.1",
    "npm": "^11.11.0"
  },
  "scripts": {
    "db:apply": "wrangler d1 migrations apply console-e2e-inbox --remote",
    "db:apply:local": "wrangler d1 migrations apply console-e2e-inbox --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postal-mime": "^2.4.3"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1",
    "wrangler": "^4.20.0"
  }
}
