{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "console-e2e-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "triggers": {
    // Purge messages past the 24h TTL even when no new mail arrives to trigger the insert-path cleanup.
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "console-e2e-inbox",
      "database_id": "d8a573b7-ad7f-4cf8-baa3-d17c0ea79fda"
    }
  ]
}
